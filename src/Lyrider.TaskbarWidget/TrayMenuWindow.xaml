<Window
    x:Class="Lyrider.TaskbarWidget.TrayMenuWindow"
    x:Name="MenuWindowRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="220"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Topmost="True"
    WindowStyle="None"
    Deactivated="MenuWindow_Deactivated"
    KeyDown="MenuWindow_KeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="TrayMenuBackgroundBrush" Color="#F9F9F9" />
        <SolidColorBrush x:Key="TrayMenuBorderBrush" Color="#D2D2D2" />
        <SolidColorBrush x:Key="TrayMenuForegroundBrush" Color="#1A1A1A" />
        <SolidColorBrush x:Key="TrayMenuHoverBrush" Color="#E8E8E8" />
        <SolidColorBrush x:Key="TrayMenuPressedBrush" Color="#DEDEDE" />
        <SolidColorBrush x:Key="TrayMenuSeparatorBrush" Color="#DADADA" />
        <Style x:Key="TrayMenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TrayMenuForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonSurface"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource TrayMenuHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource TrayMenuPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border
        Padding="4"
        Background="{DynamicResource TrayMenuBackgroundBrush}"
        BorderBrush="{DynamicResource TrayMenuBorderBrush}"
        BorderThickness="1"
        CornerRadius="9">
        <StackPanel>
            <Button
                Click="OpenButton_Click"
                FontWeight="SemiBold"
                Style="{StaticResource TrayMenuButtonStyle}">
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="14"
                    Text="打开 Lyrider" />
            </Button>
            <Border
                Height="1"
                Margin="10,2"
                Background="{DynamicResource TrayMenuSeparatorBrush}" />
            <Button Click="ExitButton_Click" Style="{StaticResource TrayMenuButtonStyle}">
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="14"
                    Text="退出 Lyrider" />
            </Button>
        </StackPanel>
    </Border>
</Window>
