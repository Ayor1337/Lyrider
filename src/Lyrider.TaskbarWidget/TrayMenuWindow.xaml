<Window
    x:Class="Lyrider.TaskbarWidget.TrayMenuWindow"
    x:Name="MenuWindowRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="244"
    AllowsTransparency="True"
    Background="Transparent"
    Opacity="0"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    SnapsToDevicePixels="True"
    Topmost="True"
    UseLayoutRounding="True"
    WindowStyle="None"
    Deactivated="MenuWindow_Deactivated"
    KeyDown="MenuWindow_KeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="TrayMenuBackgroundBrush" Color="#FCFCFC" />
        <SolidColorBrush x:Key="TrayMenuBorderBrush" Color="#24000000" />
        <SolidColorBrush x:Key="TrayMenuForegroundBrush" Color="#1A1A1A" />
        <SolidColorBrush x:Key="TrayMenuHoverBrush" Color="#0F000000" />
        <SolidColorBrush x:Key="TrayMenuPressedBrush" Color="#18000000" />
        <SolidColorBrush x:Key="TrayMenuSeparatorBrush" Color="#17000000" />
        <SolidColorBrush x:Key="TrayMenuFocusBrush" Color="#990078D4" />
        <Style x:Key="TrayMenuIconStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="TrayMenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TrayMenuForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="ButtonSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True" />
                            </Border>
                            <Border
                                x:Name="FocusBorder"
                                Margin="1"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="5"
                                IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource TrayMenuHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource TrayMenuPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource TrayMenuHoverBrush}" />
                                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource TrayMenuFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation
                        Storyboard.TargetName="MenuWindowRoot"
                        Storyboard.TargetProperty="Opacity"
                        From="0"
                        To="1"
                        Duration="0:0:0.12">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation
                        Storyboard.TargetName="MenuScale"
                        Storyboard.TargetProperty="ScaleX"
                        From="0.97"
                        To="1"
                        Duration="0:0:0.12">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation
                        Storyboard.TargetName="MenuScale"
                        Storyboard.TargetProperty="ScaleY"
                        From="0.97"
                        To="1"
                        Duration="0:0:0.12">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid
        x:Name="MenuSurface"
        Margin="10"
        RenderTransformOrigin="0.5,1">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="MenuScale" ScaleX="0.97" ScaleY="0.97" />
        </Grid.RenderTransform>
        <Border
            Padding="6"
            Background="{DynamicResource TrayMenuBackgroundBrush}"
            BorderBrush="{DynamicResource TrayMenuBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="20"
                    Direction="270"
                    Opacity="0.24"
                    ShadowDepth="4" />
            </Border.Effect>
            <StackPanel>
                <Button
                    AutomationProperties.Name="打开 Lyrider"
                    Click="OpenButton_Click"
                    FontWeight="SemiBold"
                    Style="{StaticResource TrayMenuButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource TrayMenuIconStyle}" Text="&#xE8A7;" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="14"
                            Text="打开 Lyrider" />
                    </Grid>
                </Button>
                <Border
                    Height="1"
                    Margin="38,3,10,3"
                    Background="{DynamicResource TrayMenuSeparatorBrush}" />
                <Button
                    AutomationProperties.Name="退出 Lyrider"
                    Click="ExitButton_Click"
                    Style="{StaticResource TrayMenuButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource TrayMenuIconStyle}" Text="&#xE7E8;" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="14"
                            Text="退出 Lyrider" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
