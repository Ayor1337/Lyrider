<Window
    x:Class="Lyrider.TaskbarWidget.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowsTransparency="False"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="Grayscale"
    Topmost="True"
    UseLayoutRounding="True"
    WindowStyle="None"
    Deactivated="MenuWindow_Deactivated"
    KeyDown="MenuWindow_KeyDown">
    <!--  系统材质要求窗口不是 layered window，因此关闭 AllowsTransparency，
          由 WindowChrome 保留原生 frame，让 DWM 提供圆角与投影。  -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="-1"
            ResizeBorderThickness="0"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="TrayMenuBackgroundBrush" Color="#FFF9F9F9" />
        <SolidColorBrush x:Key="TrayMenuBorderBrush" Color="#18000000" />
        <SolidColorBrush x:Key="TrayMenuForegroundBrush" Color="#FF1A1A1A" />
        <SolidColorBrush x:Key="TrayMenuHoverBrush" Color="#0A000000" />
        <SolidColorBrush x:Key="TrayMenuPressedBrush" Color="#14000000" />
        <SolidColorBrush x:Key="TrayMenuSeparatorBrush" Color="#14000000" />
        <SolidColorBrush x:Key="TrayMenuFocusBrush" Color="#990078D4" />
        <Style x:Key="TrayMenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TrayMenuForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="ButtonSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True" />
                            </Border>
                            <Border
                                x:Name="FocusBorder"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="3"
                                IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource TrayMenuHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource TrayMenuPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource TrayMenuHoverBrush}" />
                                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource TrayMenuFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border
        MinWidth="160"
        Padding="4"
        Background="{DynamicResource TrayMenuBackgroundBrush}"
        BorderBrush="{DynamicResource TrayMenuBorderBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel>
            <Button
                AutomationProperties.Name="打开 Lyrider"
                Click="OpenButton_Click"
                Content="打开 Lyrider"
                Style="{StaticResource TrayMenuButtonStyle}" />
            <Border
                Height="1"
                Margin="8,3,8,3"
                Background="{DynamicResource TrayMenuSeparatorBrush}" />
            <Button
                AutomationProperties.Name="退出 Lyrider"
                Click="ExitButton_Click"
                Content="退出 Lyrider"
                Style="{StaticResource TrayMenuButtonStyle}" />
        </StackPanel>
    </Border>
</Window>
