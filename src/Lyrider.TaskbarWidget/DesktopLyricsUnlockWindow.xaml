<Window
    x:Class="Lyrider.TaskbarWidget.DesktopLyricsUnlockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lyrider Desktop Lyrics Unlock"
    Width="24" Height="24"
    AllowsTransparency="True" Background="Transparent"
    WindowStyle="None" ResizeMode="NoResize"
    ShowInTaskbar="False" ShowActivated="False" Topmost="True"
    UseLayoutRounding="True">
    <Button x:Name="UnlockButton" Click="UnlockButton_Click" Foreground="White" Background="#01000000">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Button.Template>
        <Viewbox Width="18" Height="18" IsHitTestVisible="False">
            <Grid Width="28" Height="28">
                <Path Data="M 8,12 H 20 V 23 H 8 Z M 14,17 V 20 M 9,12 V 8 A 5,5 0 0 1 19,8"
                      Stroke="Black" StrokeThickness="4" StrokeLineJoin="Round" />
                <Path Data="M 8,12 H 20 V 23 H 8 Z M 14,17 V 20 M 9,12 V 8 A 5,5 0 0 1 19,8"
                      Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round" />
            </Grid>
        </Viewbox>
    </Button>
</Window>
