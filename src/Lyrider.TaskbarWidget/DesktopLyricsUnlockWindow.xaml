<Window
    x:Class="Lyrider.TaskbarWidget.DesktopLyricsUnlockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lyrider Desktop Lyrics Unlock"
    Width="30" Height="28"
    AllowsTransparency="True" Background="Transparent"
    WindowStyle="None" ResizeMode="NoResize"
    ShowInTaskbar="False" ShowActivated="False" Topmost="True" Opacity="0"
    UseLayoutRounding="True">
    <Button x:Name="UnlockButton" Click="UnlockButton_Click" Foreground="White" Background="#01000000">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ButtonSurface" Property="Background" Value="#30FFFFFF" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="ButtonSurface" Property="Background" Value="#50FFFFFF" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="ButtonSurface" Property="Background" Value="#30FFFFFF" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE785;" IsHitTestVisible="False" />
    </Button>
</Window>
