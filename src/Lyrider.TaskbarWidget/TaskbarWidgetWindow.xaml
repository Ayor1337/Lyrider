<Window
    x:Class="Lyrider.TaskbarWidget.TaskbarWidgetWindow"
    x:Name="TaskbarWindowRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="216"
    Height="40"
    AllowsTransparency="True"
    Background="Transparent"
    Focusable="False"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None">
    <Window.Resources>
        <SolidColorBrush x:Key="PlaybackButtonHoverBrush" Color="#20FFFFFF" />
        <SolidColorBrush x:Key="PlaybackButtonPressedBrush" Color="#34FFFFFF" />
        <Style x:Key="PlaybackButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{Binding Foreground, ElementName=TaskbarWindowRoot}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid
                            x:Name="ButtonSurface"
                            RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ButtonScale" />
                            </Grid.RenderTransform>
                            <Border
                                x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource PlaybackButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource PlaybackButtonPressedBrush}" />
                            </Trigger>
                            <EventTrigger RoutedEvent="PreviewMouseDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Canvas
        x:Name="HostCanvas"
        Background="Transparent">
        <Border
            x:Name="RootBorder"
            Width="216"
            Height="40"
            Background="#01FFFFFF"
            CornerRadius="6"
            MouseEnter="RootBorder_MouseEnter"
            MouseLeave="RootBorder_MouseLeave">
            <Grid Margin="2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="ArtworkBorder"
                Width="36"
                Height="36"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="#18FFFFFF"
                CornerRadius="5">
                <TextBlock
                    x:Name="ArtworkPlaceholder"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="20"
                    Text="&#xE8D6;" />
            </Border>

            <Grid Grid.Column="1" Margin="6,0,2,0">
                <StackPanel
                    x:Name="OutgoingInfoPanel"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>
                    <Grid Height="19" ClipToBounds="True">
                        <TextBlock
                            x:Name="OutgoingTitleText"
                            FontSize="14"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </Grid>
                    <TextBlock
                        x:Name="OutgoingArtistText"
                        Height="16"
                        Margin="0,-2,0,0"
                        FontSize="12"
                        Opacity="0.64"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>

                <StackPanel
                    x:Name="InfoPanel"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>
                    <Grid
                        x:Name="PrimaryTextViewport"
                        Height="19"
                        ClipToBounds="True"
                        SizeChanged="PrimaryTextViewport_SizeChanged">
                        <Canvas>
                            <TextBlock
                                x:Name="TitleText"
                                FontSize="14"
                                TextWrapping="NoWrap">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Canvas>
                    </Grid>
                    <TextBlock
                        x:Name="ArtistText"
                        Height="16"
                        Margin="0,-2,0,0"
                        FontSize="12"
                        Opacity="0.64"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>

                <StackPanel
                    x:Name="ControlsPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Opacity="0"
                    Orientation="Horizontal">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="2" />
                    </StackPanel.RenderTransform>
                    <Button
                        Click="PreviousButton_Click"
                        Style="{StaticResource PlaybackButtonStyle}"
                        ToolTip="上一首">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE892;" />
                    </Button>
                    <Button
                        Click="PlayPauseButton_Click"
                        Style="{StaticResource PlaybackButtonStyle}"
                        ToolTip="播放/暂停">
                        <TextBlock x:Name="PlayPauseIcon" FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE769;" />
                    </Button>
                    <Button
                        Click="NextButton_Click"
                        Style="{StaticResource PlaybackButtonStyle}"
                        ToolTip="下一首">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE893;" />
                    </Button>
                </StackPanel>
            </Grid>
            </Grid>
        </Border>
    </Canvas>
</Window>
