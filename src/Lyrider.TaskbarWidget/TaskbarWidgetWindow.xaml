<Window
    x:Class="Lyrider.TaskbarWidget.TaskbarWidgetWindow"
    x:Name="TaskbarWindowRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="216"
    Height="40"
    AllowsTransparency="True"
    Background="Transparent"
    Focusable="False"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None">
    <Window.Resources>
        <Style x:Key="PlaybackButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{Binding Foreground, ElementName=TaskbarWindowRoot}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBackground"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Canvas
        x:Name="HostCanvas"
        Background="Transparent"
        MouseEnter="RootBorder_MouseEnter"
        MouseLeave="RootBorder_MouseLeave">
        <Border
            x:Name="RootBorder"
            Width="216"
            Height="40"
            Background="Transparent"
            CornerRadius="6">
            <Grid Margin="2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="ArtworkBorder"
                Width="36"
                Height="36"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="#18FFFFFF"
                CornerRadius="5">
                <TextBlock
                    x:Name="ArtworkPlaceholder"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="20"
                    Text="&#xE8D6;" />
            </Border>

            <Grid Grid.Column="1" Margin="6,0,2,0">
                <StackPanel
                    x:Name="InfoPanel"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="12"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        x:Name="ArtistText"
                        Margin="0,-1,0,0"
                        FontSize="11"
                        Opacity="0.64"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>

                <StackPanel
                    x:Name="ControlsPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Opacity="0"
                    Orientation="Horizontal">
                    <Button
                        Click="PreviousButton_Click"
                        Style="{StaticResource PlaybackButtonStyle}"
                        ToolTip="上一首">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="17" Text="&#xE892;" />
                    </Button>
                    <Button
                        Click="PlayPauseButton_Click"
                        Style="{StaticResource PlaybackButtonStyle}"
                        ToolTip="播放/暂停">
                        <TextBlock x:Name="PlayPauseIcon" FontFamily="Segoe Fluent Icons" FontSize="17" Text="&#xE769;" />
                    </Button>
                    <Button
                        Click="NextButton_Click"
                        Style="{StaticResource PlaybackButtonStyle}"
                        ToolTip="下一首">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="17" Text="&#xE893;" />
                    </Button>
                </StackPanel>
            </Grid>
            </Grid>
        </Border>
    </Canvas>
</Window>
