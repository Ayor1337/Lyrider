<Window
    x:Class="Lyrider.TaskbarWidget.DesktopLyricsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Lyrider.TaskbarWidget"
    Title="Lyrider Desktop Lyrics"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ShowActivated="False"
    Topmost="True"
    Opacity="0"
    SizeToContent="Height"
    Width="960"
    UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="QuickMenuStyle" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinWidth" Value="210" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#F0202020" BorderBrush="#505050" BorderThickness="1" Padding="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="8,4" Background="#505050" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="ItemSurface" Background="Transparent" Padding="8,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe Fluent Icons"
                                               FontSize="12" VerticalAlignment="Center" Visibility="Hidden" />
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" />
                                    <TextBlock x:Name="Arrow" Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe Fluent Icons"
                                               FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Hidden" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-1"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Focusable="False" AllowsTransparency="True">
                                <Border Background="#F0202020" BorderBrush="#505050" BorderThickness="1" Padding="4" MinWidth="170">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#777777" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#50FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="Surface" Background="#01000000" MouseLeftButtonDown="Surface_MouseLeftButtonDown"
          MouseRightButtonUp="Surface_MouseRightButtonUp"
          MouseEnter="Surface_MouseEnter" MouseLeave="Surface_MouseLeave">
        <!-- 背景铺满窗口，与缩放边框的触发范围一致；歌词内边距由内层网格保留。 -->
        <!-- 圆角半径与角落指示弧（2px 内缩 + 6px 弧半径）对齐。 -->
        <Border x:Name="Backdrop" IsHitTestVisible="False" CornerRadius="8" />
        <Grid Margin="12,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="ToolbarSurface" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="6,2" Visibility="{Binding Visibility, ElementName=Toolbar}">
                <StackPanel x:Name="Toolbar" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Hidden">
                    <Button x:Name="PreviousButton" Click="PreviousButton_Click" Style="{StaticResource ToolbarButtonStyle}">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE892;" />
                    </Button>
                    <Button x:Name="PlayPauseButton" Click="PlayPauseButton_Click" Style="{StaticResource ToolbarButtonStyle}" Width="34">
                        <TextBlock x:Name="PlayPauseIcon" FontFamily="Segoe Fluent Icons" FontSize="18" Text="&#xE768;" />
                    </Button>
                    <Button x:Name="NextButton" Click="NextButton_Click" Style="{StaticResource ToolbarButtonStyle}">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE893;" />
                    </Button>
                    <Border Width="1" Height="16" Margin="7,0" Background="#38FFFFFF" />
                    <Button x:Name="LockButton" Click="LockButton_Click" Style="{StaticResource ToolbarButtonStyle}">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE72E;" />
                    </Button>
                    <Button x:Name="CloseButton" Click="CloseButton_Click" Style="{StaticResource ToolbarButtonStyle}">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE711;" />
                    </Button>
                </StackPanel>
            </Border>
            <local:DesktopLyricsContent x:Name="LyricsContent" Grid.Row="1" VerticalAlignment="Center" />
        </Grid>
        <!-- 四边与四角交给系统缩放循环；角在边之后声明，重叠处优先按对角缩放。
             悬停或拖动时，边的中点淡入一枚小药丸，角上淡入一段圆角弧。 -->
        <Grid x:Name="ResizeFrame">
            <Grid.Resources>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#01000000" />
                    <EventSetter Event="MouseLeftButtonDown" Handler="ResizeEdge_MouseLeftButtonDown" />
                    <EventSetter Event="MouseEnter" Handler="ResizeEdge_MouseEnter" />
                    <EventSetter Event="MouseLeave" Handler="ResizeEdge_MouseLeave" />
                </Style>
                <Style x:Key="EdgePill" TargetType="Rectangle">
                    <Setter Property="Fill" Value="#E6FFFFFF" />
                    <Setter Property="RadiusX" Value="2" />
                    <Setter Property="RadiusY" Value="2" />
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                </Style>
                <Style x:Key="CornerArc" TargetType="Path">
                    <Setter Property="Width" Value="16" />
                    <Setter Property="Height" Value="16" />
                    <Setter Property="Stroke" Value="#E6FFFFFF" />
                    <Setter Property="StrokeThickness" Value="3" />
                    <Setter Property="StrokeStartLineCap" Value="Round" />
                    <Setter Property="StrokeEndLineCap" Value="Round" />
                    <Setter Property="Opacity" Value="0" />
                </Style>
            </Grid.Resources>
            <Grid x:Name="ResizeIndicators" IsHitTestVisible="False">
                <Rectangle x:Name="LeftResizeIndicator" Tag="Left" Style="{StaticResource EdgePill}" Width="4" Height="28"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" />
                <Rectangle x:Name="RightResizeIndicator" Tag="Right" Style="{StaticResource EdgePill}" Width="4" Height="28"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0" />
                <Rectangle x:Name="TopResizeIndicator" Tag="Top" Style="{StaticResource EdgePill}" Width="28" Height="4"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" />
                <Rectangle x:Name="BottomResizeIndicator" Tag="Bottom" Style="{StaticResource EdgePill}" Width="28" Height="4"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                <Path x:Name="TopLeftResizeIndicator" Tag="Top, Left" Style="{StaticResource CornerArc}" RenderTransformOrigin="0,0"
                      HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,2,0,0"
                      Data="M 1.5,14 L 1.5,7.5 A 6,6 0 0 1 7.5,1.5 L 14,1.5" />
                <Path x:Name="TopRightResizeIndicator" Tag="Top, Right" Style="{StaticResource CornerArc}" RenderTransformOrigin="1,0"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                      Data="M 2,1.5 L 8.5,1.5 A 6,6 0 0 1 14.5,7.5 L 14.5,14" />
                <Path x:Name="BottomRightResizeIndicator" Tag="Bottom, Right" Style="{StaticResource CornerArc}" RenderTransformOrigin="1,1"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                      Data="M 14.5,2 L 14.5,8.5 A 6,6 0 0 1 8.5,14.5 L 2,14.5" />
                <Path x:Name="BottomLeftResizeIndicator" Tag="Bottom, Left" Style="{StaticResource CornerArc}" RenderTransformOrigin="0,1"
                      HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,2"
                      Data="M 14,14.5 L 7.5,14.5 A 6,6 0 0 1 1.5,8.5 L 1.5,2" />
            </Grid>
            <Border x:Name="LeftResizeEdge" Tag="Left" Width="8" HorizontalAlignment="Left" Cursor="SizeWE" />
            <Border x:Name="RightResizeEdge" Tag="Right" Width="8" HorizontalAlignment="Right" Cursor="SizeWE" />
            <Border x:Name="TopResizeEdge" Tag="Top" Height="8" VerticalAlignment="Top" Cursor="SizeNS" />
            <Border x:Name="BottomResizeEdge" Tag="Bottom" Height="8" VerticalAlignment="Bottom" Cursor="SizeNS" />
            <Border x:Name="TopLeftResizeEdge" Tag="Top, Left" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" />
            <Border x:Name="TopRightResizeEdge" Tag="Top, Right" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" />
            <Border x:Name="BottomLeftResizeEdge" Tag="Bottom, Left" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" />
            <Border x:Name="BottomRightResizeEdge" Tag="Bottom, Right" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" />
        </Grid>
    </Grid>
</Window>
