                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            FontWeight="SemiBold"
                                            Text="2" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock x:Uid="Main_068" FontWeight="SemiBold" Text="打开外部应用访问管理" />
                                        <TextBlock x:Uid="Main_069"
                                            Style="{StaticResource SettingsDescriptionStyle}"
                                            Text="在“外部应用”中打开“管理外部应用对 Cider 的访问”，然后创建并复制 Token。"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="32"
                                        Height="32"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="16">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            FontWeight="SemiBold"
                                            Text="3" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="12">
                                        <TextBlock x:Uid="Main_070" FontWeight="SemiBold" Text="粘贴并验证连接" />
                                        <TextBox x:Uid="Main_071"
                                            x:Name="OnboardingApiBaseUrlTextBox"
                                            Header="API 地址"
                                            TextChanged="OnboardingApiBaseUrlTextBox_TextChanged"
                                            PlaceholderText="http://localhost:10767/" />
                                        <PasswordBox x:Uid="Main_072"
                                            x:Name="OnboardingTokenPasswordBox"
                                            Header="App Token"
                                            PasswordChanged="OnboardingTokenPasswordBox_PasswordChanged"
                                            PlaceholderText="粘贴从 Cider 复制的 Token" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <InfoBar
                            x:Name="OnboardingStatusInfoBar"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Informational" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Uid="Main_073"
                                x:Name="SkipOnboardingButton"
                                Grid.Column="1"
                                Click="SkipOnboardingButton_Click"
                                Content="稍后设置" />
                            <Button x:Uid="Main_074"
                                x:Name="ValidateOnboardingButton"
                                Grid.Column="2"
                                Click="ValidateOnboardingButton_Click"
                                Content="验证连接"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Uid="Main_075"
                                x:Name="ConfirmOnboardingButton"
                                Grid.Column="2"
                                Click="ConfirmOnboardingButton_Click"
                                Content="确认并进入"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="Collapsed" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid
            x:Name="StartupLoadingOverlay"
            Grid.RowSpan="2"
            Canvas.ZIndex="10"
            Background="{ThemeResource LyriderRootBrush}">
            <StackPanel
                x:Name="StartupLoadingContent"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="28">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="StartupLoadingTranslateTransform" />
                </StackPanel.RenderTransform>
                <StackPanel.Transitions>
                    <TransitionCollection>
                        <EntranceThemeTransition
                            FromVerticalOffset="16"
                            IsStaggeringEnabled="False" />
                    </TransitionCollection>
                </StackPanel.Transitions>
                <Image
                    Width="88"
                    Height="88"
                    HorizontalAlignment="Center"
                    Source="Assets/Lyrider.png"
                    Stretch="Uniform" />
                <TextBlock x:Uid="Main_076"
                    HorizontalAlignment="Center"
                    FontSize="19"
                    FontWeight="SemiBold"
                    Text="正在把旋律写进此刻…" />
                <ProgressRing
                    x:Name="StartupProgressRing"
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Center"
                    IsActive="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
