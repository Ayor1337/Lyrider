<Window
    x:Class="Lyrider.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Lyrider.Models"
    mc:Ignorable="d"
    Title="Lyrider">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        SizeChanged="RootGrid_SizeChanged"
        Loaded="RootGrid_Loaded"
        Background="Transparent">
        <Grid.Resources>
            <ResourceDictionary>
                <SolidColorBrush x:Key="ConnectedBrush" Color="#FF68D391" />
                <SolidColorBrush x:Key="DisconnectedBrush" Color="#FFFF746C" />
                <Style x:Key="IconButtonStyle" TargetType="Button">
                    <Setter Property="MinWidth" Value="44" />
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="Padding" Value="8" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="10" />
                </Style>
                <Style x:Key="PlaybackButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                    <Setter Property="MinWidth" Value="52" />
                    <Setter Property="MinHeight" Value="48" />
                </Style>
                <Style x:Key="TitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                    <Setter Property="Width" Value="36" />
                    <Setter Property="Height" Value="36" />
                    <Setter Property="MinWidth" Value="36" />
                    <Setter Property="MinHeight" Value="36" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="CornerRadius" Value="8" />
                </Style>
                <Style x:Key="LyricLineButtonStyle" TargetType="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="10,6" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
                <Style x:Key="SettingsCardStyle" TargetType="Border">
                    <Setter Property="MinHeight" Value="72" />
                    <Setter Property="Padding" Value="16,12" />
                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="7" />
                </Style>
                <Style x:Key="SettingsIconStyle" TargetType="Border">
                    <Setter Property="Width" Value="36" />
                    <Setter Property="Height" Value="36" />
                    <Setter Property="Margin" Value="0,0,14,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                    <Setter Property="CornerRadius" Value="6" />
                </Style>
                <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,3,0,0" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
                <Style x:Key="SettingsLabelHostStyle" TargetType="Grid">
                    <Setter Property="MinHeight" Value="44" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style x:Key="SettingsControlHostStyle" TargetType="Grid">
                    <Setter Property="Width" Value="260" />
                    <Setter Property="Height" Value="44" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style x:Key="SettingsToggleStyle" TargetType="ToggleSwitch">
                    <Setter Property="Width" Value="76" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="PlayerBackdropLayer" Grid.RowSpan="2">
            <Grid x:Name="BackgroundArtworkHost" />
            <Rectangle
                Fill="{ThemeResource LyriderRootBrush}"
                Opacity="0.84" />
        </Grid>

        <Grid x:Name="AppTitleBar" Padding="8,0,146,0">
            <Button
                x:Name="AppMenuButton"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AutomationProperties.Name="应用菜单"
                Style="{StaticResource TitleBarButtonStyle}"
                ToolTipService.ToolTip="应用菜单">
                <FontIcon FontSize="16" Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuFlyoutItem
                            x:Name="ConnectionStatusMenuItem"
                            IsEnabled="False"
                            Text="正在连接…">
                            <MenuFlyoutItem.Icon>
                                <FontIcon
                                    x:Name="ConnectionStatusIcon"
                                    FontSize="10"
                                    Foreground="{StaticResource DisconnectedBrush}"
                                    Glyph="&#xE91F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="MenuQueueItem_Click" Text="播放队列">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8FD;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="MenuLyricsItem_Click" Text="歌词">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8D2;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="MenuSettingsItem_Click" Text="设置">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE713;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="ExitMenuItem_Click" Text="退出 Lyrider">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8BB;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Grid
            x:Name="PlayerPageGrid"
            Grid.Row="1"
            Padding="52,28,52,42"
            ColumnSpacing="72">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>

            <Grid x:Name="PlaybackPanel" MaxWidth="560" HorizontalAlignment="Stretch" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="ArtworkBorder"
                    Width="420"
                    Height="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#22FFFFFF"
                    CornerRadius="7">
                    <Grid>
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="72"
                            Foreground="{StaticResource MutedTextBrush}"
                            Glyph="&#xE93C;" />
                        <Image
                            x:Name="ArtworkImage"
                            Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock
                            x:Name="SongNameText"
                            FontSize="21"
                            FontWeight="SemiBold"
                            Text="未在播放"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="ArtistAlbumText"
                            FontSize="14"
                            Foreground="{StaticResource SubtleTextBrush}"
                            Text="—"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="更多">
                        <FontIcon FontSize="18" Glyph="&#xE712;" />
                    </Button>
                </Grid>

                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="CurrentTimeText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource SubtleTextBrush}"
                        Text="0:00" />
                    <Slider
                        x:Name="PlaybackProgressSlider"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="播放进度"
                        Maximum="1"
                        Minimum="0"
                        SmallChange="5"
                        StepFrequency="1"
                        Value="0"
                        ValueChanged="PlaybackProgressSlider_ValueChanged" />
                    <TextBlock
                        x:Name="RemainingTimeText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource SubtleTextBrush}"
                        Text="−0:00" />
                </Grid>

                <StackPanel
                    Grid.Row="3"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Button
                        x:Name="ShuffleButton"
                        Click="ShuffleButton_Click"
                        Style="{StaticResource PlaybackButtonStyle}"
                        ToolTipService.ToolTip="随机播放">
                        <FontIcon FontSize="21" Glyph="&#xE8B1;" />
                    </Button>
                    <Button
                        Click="PreviousButton_Click"
                        Style="{StaticResource PlaybackButtonStyle}"
                        ToolTipService.ToolTip="上一首">
                        <FontIcon FontSize="25" Glyph="&#xE892;" />
                    </Button>
                    <Button
                        x:Name="PlayPauseButton"
                        Click="PlayPauseButton_Click"
                        Style="{StaticResource PlaybackButtonStyle}"
                        ToolTipService.ToolTip="播放或暂停">
                        <FontIcon x:Name="PlayPauseIcon" FontSize="30" Glyph="&#xE768;" />
                    </Button>
                    <Button
                        Click="NextButton_Click"
                        Style="{StaticResource PlaybackButtonStyle}"
                        ToolTipService.ToolTip="下一首">
                        <FontIcon FontSize="25" Glyph="&#xE893;" />
                    </Button>
                    <Button
                        x:Name="RepeatButton"
                        Click="RepeatButton_Click"
                        Style="{StaticResource PlaybackButtonStyle}"
                        ToolTipService.ToolTip="循环：关闭">
                        <Grid Width="26" Height="26">
                            <FontIcon
                                x:Name="RepeatIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="21"
                                Glyph="&#xE8EE;"
                                Opacity="0.55" />
                            <Border
                                x:Name="RepeatOneBadge"
                                Width="13"
                                Height="13"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="7"
                                Visibility="Collapsed">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="1" />
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>

            </Grid>

            <Grid x:Name="DetailsPanel" Grid.Column="1">
                <Grid x:Name="QueuePanel" Padding="0,18,0,70" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock
                            FontSize="23"
                            FontWeight="SemiBold"
                            Text="播放队列" />
                        <TextBlock
                            x:Name="QueueCountText"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="0 首" />
                    </Grid>

                    <StackPanel x:Name="CurrentQueueSection" Grid.Row="1" Spacing="10">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="正在播放" />
                        <Border
                            x:Name="CurrentQueueItemBorder"
                            Padding="10"
                            Background="{StaticResource PanelFillBrush}"
                            CornerRadius="7">
                            <Grid ColumnSpacing="13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="50" Height="50" Background="#24FFFFFF" CornerRadius="4">
                                    <Image x:Name="CurrentQueueArtworkImage" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        x:Name="CurrentQueueSongText"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="未在播放"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="CurrentQueueArtistText"
                                        FontSize="13"
                                        Foreground="{StaticResource SubtleTextBrush}"
                                        Text="—"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="UpcomingQueueHeading" Grid.Row="2" Margin="0,10,0,0" Spacing="3">
                        <TextBlock
                            FontSize="17"
                            FontWeight="SemiBold"
                            Text="接下来播放" />
                        <TextBlock
                            FontSize="13"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="来自 Cider 当前播放队列" />
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <ListView
                            x:Name="QueueListView"
                            IsItemClickEnabled="True"
                            ItemClick="QueueListView_ItemClick"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:QueueItemInfo">
                                    <Grid Padding="2,8" ColumnSpacing="13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="48" Height="48" Background="#24FFFFFF" CornerRadius="4">
                                            <Image Source="{Binding ArtworkUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock
                                                FontSize="15"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{StaticResource SubtleTextBrush}"
                                                Text="{x:Bind ArtistName}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            Text="{x:Bind DurationText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Name="EmptyQueueText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="播放队列为空" />
                    </Grid>
                </Grid>

                <Grid x:Name="LyricsPanel" Visibility="Collapsed">
                    <ScrollViewer
                        x:Name="LyricsScrollViewer"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Hidden"
                        SizeChanged="LyricsScrollViewer_SizeChanged"
                        ViewChanged="LyricsScrollViewer_ViewChanged">
                        <StackPanel x:Name="LyricsStackPanel" Spacing="30">
                            <Border x:Name="LyricsTopSpacer" />
                            <Border x:Name="LyricsBottomSpacer" />
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock
                        x:Name="LyricsEmptyText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="这首歌暂时没有歌词"
                        TextAlignment="Center" />
                </Grid>

                <Border
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Padding="4"
                    Background="{ThemeResource LyriderSwitcherBrush}"
                    BorderBrush="#24FFFFFF"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Orientation="Horizontal">
                        <Button
                            x:Name="QueueViewButton"
                            Click="QueueViewButton_Click"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="播放队列">
                            <FontIcon FontSize="20" Glyph="&#xE8FD;" />
                        </Button>
                        <Button
                            x:Name="LyricsViewButton"
                            Click="LyricsViewButton_Click"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="歌词">
                            <FontIcon FontSize="20" Glyph="&#xE8D2;" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid
            x:Name="SettingsPageGrid"
            Grid.Row="1"
            Padding="0,24,0,44"
            RowSpacing="26"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SettingsPageTranslateTransform" />
            </Grid.RenderTransform>
            <Grid
                x:Name="SettingsHeaderGrid"
                Width="1020"
                MaxWidth="1020"
                HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Click="BackToPlayerButton_Click"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="返回播放器"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="返回播放器">
                    <FontIcon FontSize="16" Glyph="&#xE72B;" />
                </Button>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="设置" />
                    <TextBlock
                        FontSize="13"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="调整 Lyrider 的外观、播放体验与 Cider 连接" />
                </StackPanel>
                <Button
                    x:Name="SaveSettingsButton"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="SaveSettingsButton_Click"
                    Content="保存设置"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <ScrollViewer
                Grid.Row="1"
                HorizontalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled">
                <Grid
                    x:Name="SettingsContentGrid"
                    Width="1020"
                    MaxWidth="1020"
                    HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" Spacing="26">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="外观" />
                        <StackPanel Spacing="2">
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid x:Name="ThemeSettingsRow" RowSpacing="10" ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Style="{StaticResource SettingsLabelHostStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource SettingsIconStyle}">
                                            <FontIcon FontSize="16" Glyph="&#xE790;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" Text="主题" />
                                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="选择应用的明暗外观" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid
                                        Grid.Column="1"
                                        Style="{StaticResource SettingsControlHostStyle}"
                                        Width="260"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                        <ComboBox
                                            x:Name="ThemeComboBox"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center">
                                            <ComboBoxItem Content="跟随系统" Tag="System" />
                                            <ComboBoxItem Content="浅色" Tag="Light" />
                                            <ComboBoxItem Content="深色" Tag="Dark" />
                                        </ComboBox>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid x:Name="BackgroundSettingsRow" RowSpacing="10" ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Style="{StaticResource SettingsLabelHostStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource SettingsIconStyle}">
                                            <FontIcon FontSize="16" Glyph="&#xE91B;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" Text="背景封面强度" />
                                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="调节封面在播放器背景中的可见程度" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid
                                        Grid.Column="1"
                                        Style="{StaticResource SettingsControlHostStyle}"
                                        Width="260"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider
                                            x:Name="BackgroundOpacitySlider"
                                            VerticalAlignment="Center"
                                            Maximum="100"
                                            Minimum="0"
                                            StepFrequency="1"
                                            ValueChanged="BackgroundOpacitySlider_ValueChanged" />
                                        <TextBlock
                                            x:Name="BackgroundOpacityValueText"
                                            Grid.Column="1"
                                            Width="48"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            TextAlignment="Right" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid x:Name="BackgroundBlurSettingsRow" RowSpacing="10" ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Style="{StaticResource SettingsLabelHostStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource SettingsIconStyle}">
                                            <FontIcon FontSize="16" Glyph="&#xE71C;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" Text="背景封面模糊" />
                                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="调节背景封面的高斯模糊半径，0% 保持原图清晰" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid
                                        Grid.Column="1"
                                        Style="{StaticResource SettingsControlHostStyle}"
                                        Width="260"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider
                                            x:Name="BackgroundBlurSlider"
                                            VerticalAlignment="Center"
                                            Maximum="100"
                                            Minimum="0"
                                            StepFrequency="1"
                                            ValueChanged="BackgroundBlurSlider_ValueChanged" />
                                        <TextBlock
                                            x:Name="BackgroundBlurValueText"
                                            Grid.Column="1"
                                            Width="48"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            TextAlignment="Right" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="歌词与播放" />
                        <StackPanel Spacing="2">
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid x:Name="LyricFontSettingsRow" RowSpacing="10" ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
